PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eninti
JWT_SECRET=cambiar-esto
# Zona horaria del negocio (vencimientos y listado mensual)
APP_TZ=America/Santiago

# Solo desarrollo: deja pasar todas las peticiones como el primer administrador (sin login).
# Se ignora siempre que NODE_ENV=production.
AUTH_BYPASS=false

# URL pública del frontend: retorno de la pasarela y enlaces de los correos
APP_URL=http://localhost:5174

# Pasarela de pagos (HU-13): 'simulado' para la demo académica sin credenciales,
# 'sandbox' para la API real de Flow (requiere las credenciales de sandbox.flow.cl).
# En sandbox, Flow debe poder llegar a API_URL/api/pagos/flow/retorno (URL pública).
FLOW_MODE=simulado
# FLOW_API_KEY=
# FLOW_SECRET_KEY=
# FLOW_API_URL=https://sandbox.flow.cl/api
# API_URL=https://eninti.onrender.com

# Correo transaccional (HU-11, HU-13, HU-17): 'consola' solo lo muestra en la terminal,
# 'brevo' o 'resend' lo envía con la API del proveedor.
MAIL_MODE=consola
# MAIL_API_KEY=
# MAIL_FROM=ENINTI <avisos@tu-dominio.cl>

# Cobro mensual automático (HU-13): cada día, desde COBRO_HORA (hora de Chile), genera las
# cuotas del mes y cobra las que vencen. 'false' lo desactiva (quedan los botones manuales).
COBRO_AUTOMATICO=true
COBRO_HORA=9
# Opcional: secreto para que un cron externo dispare el cobro con
#   POST /api/tareas/cobro-diario   Authorization: Bearer <CRON_SECRET>
# Recomendado en hostings que «duermen» el servidor sin tráfico (plan gratuito de Render).
# CRON_SECRET=
