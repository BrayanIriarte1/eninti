PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eninti
JWT_SECRET=cambiar-esto

# Solo desarrollo: deja pasar todas las peticiones como administrador (sin login)
AUTH_BYPASS=false

# Pasarela de pagos (HU-13): 'simulado' para la demo académica sin credenciales,
# 'sandbox' para la API real de Flow (requiere las credenciales de sandbox.flow.cl)
FLOW_MODE=simulado
# FLOW_API_KEY=
# FLOW_SECRET_KEY=
# FLOW_API_URL=https://sandbox.flow.cl/api

# URL pública del frontend (retornos de la pasarela en modo sandbox)
# APP_URL=http://localhost:5174
