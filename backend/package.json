{
  "name": "eninti-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.js",
    "test": "node --test",
    "db:respaldo": "node --env-file-if-exists=.env scripts/db-respaldo.js",
    "test:integracion": "node --env-file-if-exists=.env scripts/integracion.js",
    "db:restaurar": "node --env-file-if-exists=.env scripts/db-restaurar.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "eninti": "file:..",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  }
}
